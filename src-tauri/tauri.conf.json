{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse Pad",
  "version": "1.1.2",
  "identifier": "com.vlaseeds.pulsepad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
    {
    "title": "Pulse Pad",
    "width": 850,
    "height": 600,
    "resizable": false,
    "maximizable": false,
    "fullscreen": false
    }
  ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
  "icons/32x32.png",
  "icons/128x128.png",
  "icons/128x128@2x.png",
  "icons/icon.icns",
  "icons/icon.ico"
  ]
  }
}
